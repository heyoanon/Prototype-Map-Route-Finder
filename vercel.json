{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/**/*.py": {
      "maxDuration": 60,
      "excludeFiles": "{tests/**,vendor/**,icons/**,*.html,*.js,*.webmanifest,**/*.test.py,**/test_*.py}"
    }
  },
  "headers": [
    {
      "source": "/service-worker.js",
      "headers": [
        { "key": "Service-Worker-Allowed", "value": "/" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/", "destination": "/map.html" },
    { "source": "/map", "destination": "/map.html" },
    { "source": "/dispatch", "destination": "/responder.html" },
    { "source": "/responder", "destination": "/responder.html" },
    { "source": "/responder-dispatch", "destination": "/responder.html" }
  ]
}
