{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/service-worker.js",
      "headers": [
        { "key": "Service-Worker-Allowed", "value": "/" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/", "destination": "/map.html" },
    { "source": "/map", "destination": "/map.html" },
    { "source": "/dispatch", "destination": "/responder.html" },
    { "source": "/responder", "destination": "/responder.html" },
    { "source": "/responder-dispatch", "destination": "/responder.html" },
    { "source": "/responder.html", "destination": "/responder.html" },
    { "source": "/service-worker.js", "destination": "/service-worker.js" },
    { "source": "/manifest.webmanifest", "destination": "/manifest.webmanifest" }
  ]
}
